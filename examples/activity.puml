@startuml
!theme sys-flat from ../themes
title Checkout flow

start
:Receive order;
if (Stock available?) then (yes)
  :Reserve items;
  :Charge payment;
  if (Payment ok?) then (yes)
    :Publish OrderCreated;
    :Return 201;
  else (no)
    :Release items;
    :Return 402;
  endif
else (no)
  :Return 409;
endif
stop
@enduml
